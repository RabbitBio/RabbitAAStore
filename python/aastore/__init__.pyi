class TextBatchStats:
    """Read-only statistics for a name or description batch."""
    def __init__(self, _unconstructible: NoReturn, /) -> None: ...
    @property
    def resident(self) -> bool: ...
    @property
    def io_uring(self) -> bool: ...
    @property
    def requested_strings(self) -> int: ...
    @property
    def requested_bytes(self) -> int: ...
    @property
    def unique_bytes(self) -> int: ...
    @property
    def ranges(self) -> int: ...
    @property
    def merged_gaps(self) -> int: ...
    @property
    def read_bytes(self) -> int: ...
    @property
    def overread_bytes(self) -> int: ...
    @property
    def max_range_bytes(self) -> int: ...

class Batch:
    """Decoded sequence bytes with lazy string access and owner-preserving views."""
    def __init__(self, _unconstructible: NoReturn, /) -> None: ...
    @property
    def stats(self) -> BatchStats: ...
    @property
    def storage(self) -> memoryview:
        """Read-only byte arena; offsets and lengths locate each sequence."""
        ...
    @property
    def offsets(self) -> memoryview:
        """Read-only native uint64 byte offsets; the view keeps this batch alive."""
        ...
    @property
    def lengths(self) -> memoryview:
        """Read-only native uint64 byte lengths, excluding terminators; keeps the batch alive."""
        ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    @overload
    def __getitem__(self, index: int, /) -> str: ...
    @overload
    def __getitem__(self, index: slice, /) -> List[str]: ...
    def size(self) -> int: ...
    def empty(self) -> bool: ...
    def view(self, index: int) -> memoryview:
        """Return a read-only byte view of one sequence, retaining this batch."""
        ...

class TextBatch:
    """UTF-8 names or descriptions with lazy string access and owner-preserving views."""
    def __init__(self, _unconstructible: NoReturn, /) -> None: ...
    @property
    def stats(self) -> TextBatchStats: ...
    @property
    def storage(self) -> memoryview:
        """Read-only byte arena; offsets and lengths locate each text item."""
        ...
    @property
    def offsets(self) -> memoryview:
        """Read-only native uint64 byte offsets; the view keeps this batch alive."""
        ...
    @property
    def lengths(self) -> memoryview:
        """Read-only native uint64 byte lengths, excluding terminators; keeps the batch alive."""
        ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    @overload
    def __getitem__(self, index: int, /) -> str: ...
    @overload
    def __getitem__(self, index: slice, /) -> List[str]: ...
    def size(self) -> int: ...
    def empty(self) -> bool: ...
    def view(self, index: int) -> memoryview:
        """Return a read-only UTF-8 byte view of one text item, retaining this batch."""
        ...

class RecordBatch:
    def __init__(self, _unconstructible: NoReturn, /) -> None: ...
    @property
    def fields(self) -> RecordFields: ...
    @property
    def names(self) -> TextBatch: ...
    @property
    def descriptions(self) -> TextBatch: ...
    @property
    def sequences(self) -> Batch: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Dict[str, str]]: ...
    @overload
    def __getitem__(self, index: int, /) -> Dict[str, str]: ...
    @overload
    def __getitem__(self, index: slice, /) -> List[Dict[str, str]]: ...
    def size(self) -> int: ...
    def empty(self) -> bool: ...
    def name(self, index: int, /) -> str: ...
    def description(self, index: int, /) -> str: ...
    def sequence(self, index: int, /) -> str: ...

class Store:
    def __init__(self, path: Path, options: StoreOptions = ...) -> None: ...
    def __enter__(self) -> Store: ...
    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any, /) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> str: ...
    def size(self) -> int: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def total_residues(self) -> int: ...
    @property
    def packed_bytes(self) -> int: ...
    @property
    def storage_mode(self) -> StorageMode: ...
    @property
    def resident_bytes(self) -> int: ...
    @property
    def resident_text_bytes(self) -> int: ...
    @property
    def preload_ns(self) -> int: ...
    @property
    def has_names(self) -> bool: ...
    @property
    def has_descriptions(self) -> bool: ...
    @property
    def decode_kernel_name(self) -> str: ...
    def sequence_length(self, id: int) -> int: ...
    def get(self, id: int) -> str: ...
    def batch_get(self, ids: Iterable[int], options: ReadOptions = ...) -> Batch: ...
    def batch_get_into(self, ids: Iterable[int], outputs: Iterable[Any],
                       options: ReadOptions = ...) -> BatchStats: ...
    def sequential_get(self, begin: int, end: int, options: ReadOptions = ...) -> Batch: ...
    def sequential_get_into(self, begin: int, end: int, outputs: Iterable[Any],
                            options: ReadOptions = ...) -> BatchStats: ...
    def batch_get_records(self, ids: Iterable[int], fields: RecordFields = RecordFields.All,
                          options: ReadOptions = ...) -> RecordBatch: ...

def build_fasta(fasta: Path, store: Path, options: Optional[BuildOptions] = None, *,
                threads: Optional[int] = None, overwrite: Optional[bool] = None,
                write_names: Optional[bool] = None, write_descriptions: Optional[bool] = None
                ) -> BuildStats: ...
