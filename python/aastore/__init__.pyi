# 文件职责：描述公开 Python 接口的类型，供 IDE 和静态检查器使用。
from os import PathLike
from typing import (
    Any, ClassVar, Dict, Iterable, Iterator, List, NoReturn, Optional,
    SupportsIndex, SupportsInt, Union, overload,
)

Path = Union[str, PathLike[str]]
__version__: str

class _PybindEnum:
    """Integer-backed pybind11 enum surface; Python Enum iteration is unsupported."""
    def __init__(self, value: Union[SupportsInt, SupportsIndex]) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...

class StorageMode(_PybindEnum):
    __members__: ClassVar[Dict[str, StorageMode]]
    ByteRange: ClassVar[StorageMode]
    PrefixMemory: ClassVar[StorageMode]
    FullMemory: ClassVar[StorageMode]

class IoBackend(_PybindEnum):
    __members__: ClassVar[Dict[str, IoBackend]]
    Auto: ClassVar[IoBackend]
    Pread: ClassVar[IoBackend]
    IoUring: ClassVar[IoBackend]

class ReadStrategy(_PybindEnum):
    __members__: ClassVar[Dict[str, ReadStrategy]]
    Sparse: ClassVar[ReadStrategy]
    Scan: ClassVar[ReadStrategy]

class RecordFields(_PybindEnum):
    __members__: ClassVar[Dict[str, RecordFields]]
    None_: ClassVar[RecordFields]
    Name: ClassVar[RecordFields]
    Description: ClassVar[RecordFields]
    Sequence: ClassVar[RecordFields]
    All: ClassVar[RecordFields]
    def __or__(self, other: RecordFields, /) -> RecordFields: ...
    def __and__(self, other: RecordFields, /) -> RecordFields: ...

class BuildOptions:
    threads: int
    overwrite: bool
    write_names: bool
    write_descriptions: bool
    def __init__(self, *, threads: int = 1, overwrite: bool = False,
                 write_names: bool = True, write_descriptions: bool = True) -> None: ...

class StoreOptions:
    storage_mode: StorageMode
    cache_bytes: int
    threads: int
    resident_names: bool
    resident_descriptions: bool
    def __init__(self, *, storage_mode: StorageMode = StorageMode.ByteRange,
                 cache_bytes: int = 0, threads: int = 8,
                 resident_names: bool = False, resident_descriptions: bool = False) -> None: ...

class ReadOptions:
    threads: int
    io_backend: IoBackend
    io_queue_depth: int
    io_buffer_bytes: int
    input_sorted: bool
    read_strategy: ReadStrategy
    merge_gap_bytes: int
    max_merged_range_bytes: int
    max_exact_merged_range_bytes: int
    scan_max_range_bytes: int
    collect_diagnostics: bool
    def __init__(self, *, threads: int = 8, io_backend: IoBackend = IoBackend.Auto,
                 io_queue_depth: int = 64, io_buffer_bytes: int = 16777216,
                 input_sorted: bool = False, read_strategy: ReadStrategy = ReadStrategy.Sparse,
                 merge_gap_bytes: int = 4096, max_merged_range_bytes: int = 16384,
                 max_exact_merged_range_bytes: int = 1048576, scan_max_range_bytes: int = 262144,
                 collect_diagnostics: bool = False) -> None: ...

# Result classes have no native constructor; the private NoReturn argument models this.
class BuildStats:
    """Read-only counts and byte sizes of a completed build."""
    def __init__(self, _unconstructible: NoReturn, /) -> None: ...
    @property
    def sequences(self) -> int: ...
    @property
    def residues(self) -> int: ...
    @property
    def packed_bytes(self) -> int: ...
    @property
    def name_bytes(self) -> int: ...
    @property
    def description_bytes(self) -> int: ...

