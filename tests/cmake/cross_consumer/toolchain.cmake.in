set(checked_variables [==[@checked_variables@]==])
foreach(variable IN LISTS checked_variables)
    set(actual_${variable} "${${variable}}")
endforeach()
include([==[@settings_file@]==])
if(CMAKE_SOURCE_DIR STREQUAL [==[@AASTORE_SOURCE_DIR@/tests/install_consumer]==])
    foreach(variable IN LISTS checked_variables)
        if(NOT "${actual_${variable}}" STREQUAL "${${variable}}")
            message(FATAL_ERROR "Consumer initial cache did not preserve ${variable}")
        endif()
    endforeach()
    if(NOT CMAKE_TOOLCHAIN_FILE STREQUAL [==[@toolchain_file@]==])
        message(FATAL_ERROR "Consumer toolchain path was not made absolute")
    endif()
    file(APPEND [==[@toolchain_marker@]==] "Consumer toolchain loaded\n")
endif()
